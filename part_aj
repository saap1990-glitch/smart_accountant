    for (final key in widget.columnKeys) {
      _controllers[key] = TextEditingController(text: existing?[key]?.toString() ?? '');
    }
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text(existing != null ? 'تعديل' : 'إضافة'),
