  }) async {
    final excel = Excel.createExcel();
    final sheet = excel['Sheet1'];
    sheet.appendRow(headers.map((h) => TextCellValue(h)).toList());
    for (var row in rows) {
      sheet.appendRow(row.map((cell) => TextCellValue(cell)).toList());
