            '❓ الإجابة عن أسئلة الاستخدام\n\n'
            'جرب: "${_knowledgeBase.suggestions.first}"';
        break;
      default:
        reply = 'جاري تطوير هذه الميزة. يمكنك تجربة: ${_knowledgeBase.suggestions.first}';
    }

    _memory.addAssistantMessage(reply);
    return reply;
