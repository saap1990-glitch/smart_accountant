,
    
    'لماذا لا يحفظ القيد؟':
        'تأكد من:\n'
        '- تساوي مجموع المدين والدائن\n'
        '- عدم استخدام حسابات رئيسية (لها أبناء)\n'
        '- الترحيل فقط للحسابات النهائية',
    
    'كيف أضيف عميل جديد؟':
        '1. اذهب إلى البيانات الأساسية > العملاء\n'
        '2. اضغط + لإضافة عميل\n'
        '3. سيتم إنشاء حساب محاسبي للعميل تلقائياً',
  };

  String? findAnswer(String question) {
    final lower = question.toLowerCase().trim();
    for (var entry in _faq.entries) {
      final keyWords = entry.key.replaceAll('؟', '').split(' ');
      final matchCount = keyWords.where((w) => lower.contains(w)).length;
      if (matchCount >= keyWords.length * 0.6) {
        return entry.value;
      }
    }
    return null;
  }

