    'أنشئ فاتورة بيع للعميل أحمد',
    'كم رصيد الصندوق الرئيسي؟',
    'اعرض تقرير الأرباح الشهري',
    'أرسل كشف حساب العميل محمد',
    'كيف أضيف صنف جديد؟',
  ];
}


