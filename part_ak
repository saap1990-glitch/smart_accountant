                            code: code.text.trim().isEmpty
                                ? null
                                : code.text.trim(),
                            location: location.text.trim().isEmpty
                                ? null
                                : location.text.trim(),
                            address: address.text.trim().isEmpty
                                ? null
                                : address.text.trim(),
                            notes: notes.text.trim().isEmpty
                                ? null
                                : notes.text.trim(),
                            isActive: active,
                          );
                        } else {
                          await _service.updateWarehouse(
                            existing['id'] as int,
