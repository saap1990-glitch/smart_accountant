diff --git a/smart_accountant/lib/core/event_bus/event_bus.dart b/smart_accountant/lib/core/event_bus/event_bus.dart
index e69de29..c5b2e8e 100644
--- a/smart_accountant/lib/core/event_bus/event_bus.dart
+++ b/smart_accountant/lib/core/event_bus/event_bus.dart
@@ -0,0 +1,26 @@
+import 'dart:async';
+
+/// حافلة الأحداث المركزية للتواصل بين المكونات بدون اقتران مباشر
+class EventBus {
+  final StreamController<dynamic> _streamController = StreamController<dynamic>.broadcast();
+
+  // إرسال حدث
+  void emit(dynamic event) {
+    if (!_streamController.isClosed) {
+      _streamController.add(event);
+    }
+  }
+
+  // الاستماع للأحداث
+  Stream<T> on<T>() => _streamController.stream.where((event) => event is T).cast<T>();
+
+  // تنظيف الموارد
+  void dispose() {
+    _streamController.close();
+  }
+
+  // Singleton
+  static final EventBus _instance = EventBus._internal();
+  factory EventBus() => _instance;
+  EventBus._internal();
+}
